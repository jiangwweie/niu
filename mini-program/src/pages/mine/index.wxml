<view class="container">
  <view class="header">
    <text class="title">当前用户</text>
    <view class="user-info" wx:if="{{currentUser}}">
      <text>姓名：{{currentUser.realName || currentUser.userName || currentUser.username}}</text>
      <text wx:if="{{apiMode === 'mock'}}">角色：{{currentUser.roleName}}</text>
      <text wx:if="{{apiMode === 'mock'}}">门店：{{currentUser.storeName}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{apiMode === 'mock'}}">
    <text class="section-title">切换 Mock 用户</text>
    <view class="user-list">
      <view 
        class="user-item {{currentUser.userId === item.userId ? 'active' : ''}}" 
        wx:for="{{mockUsers}}" 
        wx:key="userId"
        data-id="{{item.userId}}"
        bindtap="onSwitchUser"
      >
        <text>{{item.userName}} ({{item.roleName}})</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">快捷操作</text>
    <t-button wx:if="{{hasReimbursementPermission}}" theme="primary" block size="large" bind:tap="goToReimbursement">提交报销</t-button>
    <view style="margin-top: 16px;">
      <t-button theme="danger" variant="outline" block size="large" bind:tap="handleLogout">退出登录</t-button>
    </view>
  </view>
</view>
