<view class="container">
  <view class="header user-card">
    <view class="avatar-wrap">
      <t-icon name="user-circle" size="96rpx" color="#df001f" />
    </view>
    <view class="user-info" wx:if="{{currentUser}}">
      <text class="user-name">{{displayUserName}}</text>
      <view class="meta-list">
        <text class="user-desc" wx:if="{{displayAccount}}">账号：{{displayAccount}}</text>
        <text class="user-desc" wx:if="{{displayRole}}">角色：{{displayRole}}</text>
        <text class="user-desc" wx:if="{{displayStore}}">门店：{{displayStore}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{apiMode === 'mock'}}">
    <text class="section-title">切换 Mock 用户</text>
    <view class="user-list">
      <view 
        class="user-item {{currentUser.userId === item.userId ? 'active' : ''}}" 
        wx:for="{{mockUsers}}" 
        wx:key="userId"
        data-id="{{item.userId}}"
        bindtap="onSwitchUser"
      >
        <text>{{item.userName}} ({{item.roleName}})</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">常用功能</text>
    <t-button wx:if="{{hasReimbursementPermission}}" theme="primary" block size="large" bind:tap="goToReimbursement">提交报销</t-button>
  </view>

  <view class="section account-section">
    <text class="section-title">账号操作</text>
    <t-button theme="default" variant="outline" block size="large" bind:tap="handleLogout">退出登录</t-button>
  </view>
</view>
