.container {
  padding: 32rpx;
}
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff, #fefefe);
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
  margin-bottom: 48rpx;
}
.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: rgba(223,0,31,0.05);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 32rpx;
}
.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.user-desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}
.meta-list {
  display: flex;
  flex-direction: column;
}
.section {
  background: #fff;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  display: block;
}
.user-item {
  padding: 24rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.user-item.active {
  border-color: #e33e33;
  color: #e33e33;
  background: rgba(227, 62, 51, 0.05);
}
.account-section {
  background: #fafafa;
}
