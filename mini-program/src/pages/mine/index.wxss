page {
  background: #f5f6f8;
}

.container {
  padding: 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #df001f, #ff4d4f);
  padding: 48rpx 36rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(223, 0, 31, 0.2);
  margin-bottom: 32rpx;
  color: #fff;
}
.avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 28rpx;
  font-size: 60rpx;
  flex-shrink: 0;
}
.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}
.user-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}
.meta-list {
  display: flex;
  flex-direction: column;
}

/* 功能区块 */
.section {
  background: #fff;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

/* Mock 用户切换区 */
.user-item {
  padding: 20rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #444;
}
.user-item.active {
  border-color: #df001f;
  color: #df001f;
  background: rgba(223, 0, 31, 0.04);
}

/* 账号操作区 */
.account-section {
  background: #fafafa;
}

/* 微信绑定状态 */
.wechat-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.wechat-status.bound {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.wechat-status.bound .wechat-status-text {
  color: #07c160;
  font-size: 28rpx;
  font-weight: 500;
}

.wechat-status.unbound .wechat-status-text {
  color: #999;
  font-size: 28rpx;
}

.wechat-bound-time {
  font-size: 24rpx;
  color: #999;
}
