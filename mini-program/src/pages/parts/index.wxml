<view class="container">
  <t-search value="{{keyword}}" placeholder="搜索配件编码、名称、官方品号" bind:change="onSearch" bind:clear="onClear" />
  
  <view class="list">
    <block wx:if="{{parts.length > 0}}">
      <view class="card" wx:for="{{parts}}" wx:key="id" bindtap="onTapDetail" data-id="{{item.id}}">
        <view class="card-header">
          <text class="title">{{item.partName}}</text>
          <t-tag theme="{{item.source === 'OFFICIAL' ? 'primary' : 'warning'}}">{{item.source === 'OFFICIAL' ? '官方' : '第三方'}}</t-tag>
        </view>
        <view class="card-body">
          <text class="info">编码: {{item.partCode}}</text>
          <text class="info" wx:if="{{item.officialPartNo}}">官方品号: {{item.officialPartNo}}</text>
          <text class="info" wx:if="{{item.model}}">型号: {{item.model}}</text>
          <text class="info">分类: {{item.categoryCode}}</text>
        </view>
      </view>
    </block>
    <view wx:if="{{loading && parts.length === 0}}" class="loading-tip">加载中...</view>
    <view wx:elif="{{!loading && parts.length === 0 && keyword}}" class="empty">
      <t-icon name="search" size="64rpx" color="#B8C1CC" />
      <text class="empty-text">没有找到相关配件，请更换关键词</text>
    </view>
    <view wx:elif="{{!loading && parts.length === 0}}" class="empty">
      <t-icon name="layers" size="64rpx" color="#B8C1CC" />
      <text class="empty-text">暂无配件</text>
    </view>
  </view>
</view>
