.container {
  padding-bottom: 40rpx;
}
.list {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.card-body {
  display: flex;
  flex-direction: column;
}
.info {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading-tip {
  padding: 48rpx;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
