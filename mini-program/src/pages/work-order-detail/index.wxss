.container {
  padding-bottom: 40rpx;
}
.header-card {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
}
.status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.status-pill {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.progress-DRAFT       { background: #e8f0fe; color: #0052d9; }
.progress-REPAIRING   { background: #fff3cd; color: #e37318; }
.progress-REPAIR_DONE { background: #e6f4ed; color: #2ba471; }
.progress-DELIVERED   { background: #e6f4ed; color: #2ba471; }
.progress-CANCELLED   { background: #f5f5f5; color: #999; }
.progress-LEGACY      { background: #fde2e2; color: #c4473a; }
.cashier-NO_CHARGE       { background: #e8f0fe; color: #0052d9; }
.cashier-UNPAID          { background: #fff3cd; color: #e37318; }
.cashier-PARTIAL_PAID    { background: #fff3cd; color: #e37318; }
.cashier-PAID            { background: #e6f4ed; color: #2ba471; }
.cashier-REFUND_PENDING  { background: #fde2e2; color: #c4473a; }
.cashier-PARTIAL_REFUNDED { background: #fde2e2; color: #c4473a; }
.cashier-REFUNDED        { background: #f5f5f5; color: #999; }
.inventory-NOT_RESERVED { background: #f5f5f5; color: #999; }
.inventory-RESERVED     { background: #fff3cd; color: #e37318; }
.inventory-CONSUMED     { background: #e6f4ed; color: #2ba471; }
.inventory-RELEASED     { background: #f5f5f5; color: #999; }
.customer-info {
  display: flex;
  align-items: center;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
}
.phone {
  font-size: 28rpx;
  color: #666;
}
.hint-card {
  display: flex;
  align-items: flex-start;
  background: #e6f0ff;
  padding: 20rpx 28rpx;
  border-radius: 12rpx;
  margin: 0 24rpx 24rpx;
}
.hint-text {
  font-size: 26rpx;
  color: #0052d9;
  margin-left: 12rpx;
  line-height: 1.5;
  flex: 1;
}
.section {
  background: #fff;
  margin-bottom: 24rpx;
  padding-top: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  padding: 0 32rpx 16rpx;
  display: block;
  border-bottom: 1rpx solid #eee;
}
.fee-list {
  padding: 0 32rpx;
}
.fee-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}
.fee-item:last-child {
  border-bottom: none;
}
.fee-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.fee-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.fee-body {
  display: flex;
  flex-direction: column;
}
.fee-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}
.fee-amount {
  font-size: 28rpx;
  color: #e33e33;
  font-weight: bold;
  margin-top: 8rpx;
  text-align: right;
}
.empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}
.cashier-card {
  padding: 32rpx;
}
.cashier-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
}
.cashier-grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cashier-label {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}
.cashier-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}
.cashier-green { color: #2ba471; }
.highlight-amber {
  color: #fa8c16;
}
.action-section {
  padding: 32rpx;
}
.action-body {
  margin-top: 24rpx;
}
.action-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
  text-align: center;
  line-height: 1.5;
}
.cashier-actions-section {
  padding: 32rpx;
}
.cashier-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.cashier-actions t-button {
  flex: 1;
}
.other-actions-card {
  padding: 32rpx;
}
.other-actions-body {
  margin-top: 24rpx;
}
.popup-panel {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}
.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 32rpx 20rpx;
  background: #ffffff;
}

.dialog-content {
  color: #667085;
  font-size: 28rpx;
}

.dialog-desc {
  display: block;
  margin-bottom: 20rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.5;
}

.dialog-form-row {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
  background: #f7f9fb;
  border: 1rpx solid #e6e9ef;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.dialog-form-input {
  min-width: 0;
  flex: 1;
  height: 76rpx;
  color: #1f2933;
  font-size: 28rpx;
}

.dialog-form-action {
  min-width: 88rpx;
  color: #0052d9;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.dialog-section-label {
  display: block;
  margin-bottom: 16rpx;
  color: #1f2933;
  font-size: 28rpx;
  font-weight: 600;
}

.popup-body {
  max-height: 72vh;
  box-sizing: border-box;
}
.popup-footer {
  padding: 32rpx;
  background: #fff;
}
