<view class="container" wx:if="{{order}}">
  <!-- 顶部卡片 -->
  <view class="header-card">
    <view class="header-row">
      <text class="title">{{order.workOrderNo}}</text>
    </view>
    <!-- 状态标签行 -->
    <view class="status-row">
      <view class="status-pill progress-{{order.progressStatus || 'UNKNOWN'}}" wx:if="{{order.progressStatusText}}">{{order.progressStatusText}}</view>
      <view class="status-pill cashier-{{order.cashierStatus || 'UNKNOWN'}}" wx:if="{{order.cashierText}}">{{order.cashierText}}</view>
      <view class="status-pill inventory-{{order.inventoryStatus || 'UNKNOWN'}}" wx:if="{{order.inventoryText}}">{{order.inventoryText}}</view>
      <!-- 旧状态兼容 -->
      <view class="status-pill progress-LEGACY" wx:if="{{!order.progressStatus && order.status}}">旧状态，请先清理试运行数据</view>
    </view>
    <view class="customer-info">
      <text class="name">{{order.customerNameSnapshot}}</text>
      <text class="phone">{{order.customerPhoneSnapshot}}</text>
    </view>
  </view>

  <!-- 提示建议 -->
  <view class="hint-card" wx:if="{{hintText}}">
    <t-icon name="info-circle" size="16" color="#0052d9" />
    <text class="hint-text">{{hintText}}</text>
  </view>

  <!-- 基础信息 -->
  <view class="section">
    <text class="section-title">基础信息</text>
    <t-cell-group>
      <t-cell title="车型" note="{{order.vehicleModelSnapshot || '-'}}" />
      <t-cell title="车架号" note="{{order.frameNoSnapshot || '-'}}" />
      <t-cell title="电池号" note="{{order.batteryNoSnapshot || '-'}}" />
      <t-cell title="维修项目" note="{{order.repairItem || '-'}}" />
      <t-cell title="备注" note="{{order.remark || '-'}}" />
      <t-cell wx:if="{{order.noChargeReason}}" title="无需收款原因" note="{{order.noChargeReasonText || '-'}}" />
      <t-cell wx:if="{{order.noChargeRemark}}" title="无需收款备注" note="{{order.noChargeRemark}}" />
    </t-cell-group>
  </view>

  <!-- 费用明细 -->
  <view class="section">
    <text class="section-title">费用明细</text>
    <view class="fee-list" wx:if="{{order.chargeItems && order.chargeItems.length > 0}}">
      <view class="fee-item" wx:for="{{order.chargeItems}}" wx:key="id">
        <view class="fee-header">
          <text class="fee-name">{{item.itemName}}</text>
          <t-tag theme="default" variant="outline">{{item.chargeType === 'PART' ? '配件' : (item.chargeType === 'LABOR' ? '工时' : '其他')}}</t-tag>
        </view>
        <view class="fee-body">
          <text class="fee-desc" wx:if="{{item.chargeType === 'PART'}}">编码: {{item.partCodeSnapshot}}</text>
          <text class="fee-desc">单价: ¥{{item.unitPrice}} x {{item.quantity}}</text>
          <text class="fee-amount">¥{{item.lineAmount}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>暂无费用明细</view>
  </view>

  <!-- 收银信息 -->
  <view class="section cashier-card">
    <text class="section-title">收银信息</text>
    <view class="cashier-grid">
      <view class="cashier-grid-item">
        <text class="cashier-label">应收金额</text>
        <text class="cashier-value">¥{{receivableAmountStr}}</text>
      </view>
      <view class="cashier-grid-item">
        <text class="cashier-label">净实收</text>
        <text class="cashier-value cashier-green">¥{{netReceivedStr}}</text>
      </view>
      <view class="cashier-grid-item">
        <text class="cashier-label">待收金额</text>
        <text class="cashier-value {{outstandingAmount > 0 ? 'highlight-amber' : ''}}">¥{{outstandingAmountStr}}</text>
      </view>
      <view class="cashier-grid-item" wx:if="{{refundableAmount > 0}}">
        <text class="cashier-label">可退金额</text>
        <text class="cashier-value highlight-amber">¥{{refundableAmountStr}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮区 -->
  <!-- 标记维修完成 -->
  <view class="section action-section" wx:if="{{order.canMarkRepairDone}}">
    <text class="section-title">维修操作</text>
    <view class="action-body">
      <t-button theme="primary" block size="large" bind:tap="openMarkRepairDoneDialog" loading="{{markRepairDoneLoading}}">标记维修完成</t-button>
      <text class="action-tip">标记维修完成后，工单配件库存将正式扣减，不能再普通取消工单。</text>
    </view>
  </view>

  <!-- 交付关闭 -->
  <view class="section action-section" wx:if="{{order.canDeliver}}">
    <text class="section-title">交付操作</text>
    <view class="action-body">
      <t-button theme="primary" block size="large" bind:tap="openDeliverDialog" loading="{{deliverLoading}}">交付关闭</t-button>
    </view>
  </view>

  <!-- 收款按钮 -->
  <view class="section cashier-actions-section" wx:if="{{order.canRecordPayment || order.canRecordRefund}}">
    <text class="section-title">收银操作</text>
    <view class="cashier-actions">
      <t-button wx:if="{{order.canRecordPayment}}" theme="primary" variant="base" block size="medium" bind:tap="openPaymentPopup">记录收款</t-button>
      <t-button wx:if="{{order.canRecordRefund}}" theme="warning" variant="outline" block size="medium" bind:tap="openRefundPopup">记录退款</t-button>
    </view>
  </view>

  <!-- 取消工单 -->
  <view class="section other-actions-card" wx:if="{{order.canCancel}}">
    <text class="section-title">其他操作</text>
    <view class="other-actions-body">
      <t-button theme="danger" variant="outline" block size="medium" bind:tap="onCancel" loading="{{cancelLoading}}">取消工单</t-button>
      <text class="action-tip">取消工单将关闭此工单；如已预占库存，系统将自动释放。若已有收款，请后续处理退款。</text>
    </view>
  </view>
</view>

<view class="loading-wrap" wx:else>
  <t-loading theme="circular" size="48rpx" text="加载中..." />
</view>

<t-dialog id="t-dialog" />

<!-- 取消工单对话框 -->
<t-dialog
  visible="{{cancelDialogVisible}}"
  title="取消工单"
  confirm-btn="确认取消"
  cancel-btn="返回"
  bind:confirm="onConfirmCancel"
  bind:cancel="onCancelCancelDialog"
>
  <view slot="content" style="font-size: 14px; color: #666;">
    <text style="display: block; margin-bottom: 12px;">取消工单将关闭此工单；如已预占库存，系统将自动释放。若已有收款，请后续处理退款。</text>
    <t-input placeholder="请输入取消原因(必填)" value="{{cancelReason}}" bind:change="onCancelReasonChange" borderless style="background: #f5f5f5; border-radius: 4px; margin-bottom: 8px;" />
    <t-input placeholder="可输入备注(选填)" value="{{cancelRemark}}" bind:change="onCancelRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
  </view>
</t-dialog>

<!-- 记录收款弹窗 -->
<t-popup visible="{{paymentDialogVisible}}" bind:visible-change="onPaymentPopupVisibleChange" placement="bottom">
  <view class="popup-panel">
    <view class="popup-header">
      <text class="popup-title">记录线下收款</text>
      <t-icon name="close" size="24" bind:tap="closePaymentDialog" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <view style="padding: 16px; background: #fff4e5; color: #d97100; font-size: 12px; margin-bottom: 16px;">
        注意：此处仅记录线下收款结果。收款不改变工单进度状态。
      </view>
      <t-cell-group>
        <t-input label="工单编号" value="{{order.workOrderNo || '草稿'}}" align="right" readonly />
        <t-input label="应收总计" value="¥{{receivableAmountStr}}" align="right" readonly />
        <t-input label="净实收" value="¥{{netReceivedStr}}" align="right" readonly />
        <t-input label="待收金额" value="¥{{outstandingAmountStr}}" align="right" readonly />
        <view wx:if="{{outstandingAmount <= 0}}" style="padding: 8px 16px; background: #f0f9eb; color: #52c41a; font-size: 12px; margin-bottom: 12px;">已无待收金额</view>
        <t-input label="收款金额" type="digit" placeholder="{{outstandingAmount > 0 ? '不超过待收¥' + outstandingAmountStr : '已收齐'}}" value="{{paymentForm.amount}}" bind:change="onPaymentFormChange" data-field="amount" align="right" />

        <view style="padding: 16px; display: flex; align-items: center; justify-content: space-between;">
          <text style="font-size: 16px; color: #333;">收款方式</text>
        </view>
        <view style="padding: 0 16px 16px;">
          <view style="display: flex; flex-wrap: wrap; gap: 8px;">
            <t-tag theme="{{paymentForm.paymentMethod === 'WECHAT' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'WECHAT' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="WECHAT">微信</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'ALIPAY' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'ALIPAY' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="ALIPAY">支付宝</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'UNIONPAY' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'UNIONPAY' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="UNIONPAY">银联</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'CASH' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'CASH' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="CASH">现金</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'OTHER' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'OTHER' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="OTHER">其他</t-tag>
          </view>
        </view>

        <t-input label="备注" placeholder="选填" value="{{paymentForm.remark}}" bind:change="onPaymentFormChange" data-field="remark" align="right" />
      </t-cell-group>

      <view class="popup-footer">
        <t-button theme="primary" block size="large" bind:tap="confirmRecordPayment" loading="{{paymentLoading}}">确认收款</t-button>
      </view>
    </scroll-view>
  </view>
</t-popup>

<!-- 记录退款弹窗 -->
<t-popup visible="{{refundDialogVisible}}" bind:visible-change="onRefundPopupVisibleChange" placement="bottom">
  <view class="popup-panel">
    <view class="popup-header">
      <text class="popup-title">记录线下退款</text>
      <t-icon name="close" size="24" bind:tap="closeRefundDialog" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <view style="padding: 16px; background: #fff4e5; color: #d97100; font-size: 12px; margin-bottom: 16px;">
        注意：此处仅记录线下退款结果。
      </view>
      <t-cell-group>
        <t-input label="可退金额" value="¥{{refundableAmountStr}}" align="right" readonly />
        <t-input label="退款金额" type="digit" placeholder="{{refundableAmount > 0 ? '不超过可退 ¥' + refundableAmountStr : '无可退金额'}}" value="{{refundForm.amount}}" bind:change="onRefundFormChange" data-field="amount" align="right" />

        <view style="padding: 16px; display: flex; align-items: center; justify-content: space-between;">
          <text style="font-size: 16px; color: #333;">退款方式</text>
        </view>
        <view style="padding: 0 16px 16px;">
          <view style="display: flex; flex-wrap: wrap; gap: 8px;">
            <t-tag theme="{{refundForm.refundMethod === 'WECHAT' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'WECHAT' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="WECHAT">微信</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'ALIPAY' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'ALIPAY' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="ALIPAY">支付宝</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'UNIONPAY' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'UNIONPAY' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="UNIONPAY">银联</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'CASH' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'CASH' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="CASH">现金</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'OTHER' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'OTHER' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="OTHER">其他</t-tag>
          </view>
        </view>

        <t-input label="退款原因" placeholder="必填" value="{{refundForm.reason}}" bind:change="onRefundFormChange" data-field="reason" align="right" />
        <t-input label="备注" placeholder="选填" value="{{refundForm.remark}}" bind:change="onRefundFormChange" data-field="remark" align="right" />
      </t-cell-group>

      <view class="popup-footer">
        <t-button theme="danger" block size="large" bind:tap="confirmRecordRefund" loading="{{refundLoading}}">确认退款</t-button>
      </view>
    </scroll-view>
  </view>
</t-popup>

<!-- 标记维修完成对话框 -->
<t-dialog
  visible="{{markRepairDoneDialogVisible}}"
  title="标记维修完成"
  confirm-btn="确认"
  cancel-btn="返回"
  bind:confirm="onConfirmMarkRepairDone"
  bind:cancel="onCancelMarkRepairDone"
>
  <view slot="content" style="font-size: 14px; color: #666;">
    <text style="display: block; margin-bottom: 12px;">标记维修完成后，工单配件库存将正式扣减，不能再普通取消工单。</text>
    <block wx:if="{{order.receivableAmount <= 0}}">
      <text style="display: block; margin-bottom: 8px; font-weight: 500; color: #333;">应收为 0，请选择无需收款原因：</text>
      <view style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
        <t-tag
          wx:for="{{noChargeReasons}}"
          wx:key="*this"
          theme="{{noChargeReason === item ? 'primary' : 'default'}}"
          variant="{{noChargeReason === item ? 'light' : 'outline'}}"
          bind:tap="onSelectNoChargeReason"
          data-val="{{item}}"
        >{{item}}</t-tag>
      </view>
      <t-input placeholder="无需收款原因(必填)" value="{{noChargeReason}}" bind:change="onNoChargeReasonChange" borderless style="background: #f5f5f5; border-radius: 4px; margin-bottom: 8px;" />
      <t-input placeholder="无需收款备注(选填)" value="{{noChargeRemark}}" bind:change="onNoChargeRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
    </block>
  </view>
</t-dialog>

<!-- 交付关闭对话框 -->
<t-dialog
  visible="{{deliverDialogVisible}}"
  title="确认交付关闭"
  confirm-btn="确认交付"
  cancel-btn="返回"
  bind:confirm="onConfirmDeliver"
  bind:cancel="onCancelDeliver"
>
  <view slot="content" style="font-size: 14px; color: #666;">
    <text style="display: block; margin-bottom: 12px;">工单进度：{{order.progressStatusText}}</text>
    <text style="display: block; margin-bottom: 12px;">收银状态：{{order.cashierStatusText}}</text>
    <text style="display: block; margin-bottom: 12px;">应收金额：¥{{receivableAmountStr}}</text>
    <text style="display: block; margin-bottom: 12px;">净实收：¥{{netReceivedStr}}</text>
    <text style="display: block; margin-bottom: 12px;">待收金额：¥{{outstandingAmountStr}}</text>
    <text style="display: block; margin-bottom: 12px; color: #333;">{{deliverConfirmText}}</text>
  </view>
</t-dialog>

<t-toast id="t-toast" />
