page { background-color: #f5f5f5; }
.container { padding: 16px; }
.pb-safe { padding-bottom: env(safe-area-inset-bottom); }

.warning-banner {
  display: flex;
  background: #e6f0ff;
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 16px;
  align-items: flex-start;
}
.warning-banner text {
  font-size: 13px;
  color: #0052d9;
  margin-left: 8px;
  flex: 1;
  line-height: 1.5;
}

.section {
  background: #fff;
  border-radius: 8px;
  padding: 16px 0;
  margin-bottom: 16px;
}
.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin: 0 16px 12px;
}
.section-title.mt {
  margin-top: 16px;
}

.action-bar { padding: 16px; }

.draft-summary {
  padding: 0 16px 16px;
  border-bottom: 1px solid #f0f0f0;
}
.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.status-pills {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}
.wo-no { font-weight: bold; font-size: 16px; }
.summary-info {
  display: block;
  font-size: 14px;
  color: #666;
  margin-top: 4px;
}

.item-list { padding: 0 16px; }
.item-card {
  background: #f9f9f9;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 12px;
  border: 1px solid #eee;
}
.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}
.item-title { display: flex; align-items: center; }
.item-name { font-weight: 500; font-size: 15px; margin-left: 8px; }
.item-actions { display: flex; }
.item-body { display: flex; flex-direction: column; }
.item-desc { font-size: 13px; color: #666; margin-top: 4px; }
.item-amount { font-size: 16px; font-weight: bold; color: #e34d59; align-self: flex-end; margin-top: 4px; }

.empty-state { text-align: center; color: #999; padding: 24px 0; font-size: 14px; }

.total-bar {
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #f0f0f0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 16px;
  font-weight: bold;
}
.total-amount { color: #e34d59; font-size: 18px; }

.add-actions { padding: 0 16px; }

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #f0f0f0;
}
.popup-title { font-size: 16px; font-weight: 600; }
.popup-body { max-height: 70vh; }
.popup-footer { padding: 16px; padding-bottom: calc(16px + env(safe-area-inset-bottom)); }

.scan-part-actions {
  display: flex;
  gap: 12px;
  padding: 12px 16px;
}

.selected-part-panel {
  margin: 0 16px 12px;
  padding: 10px 12px;
  background: #f3f8ff;
  border: 1px solid #b3d4ff;
  border-radius: 8px;
}

.part-list { height: calc(80vh - 120px); }
.part-item { padding: 16px; border-bottom: 1px solid #f0f0f0; }
.part-item-header { margin-bottom: 4px; }
.part-name { font-size: 15px; color: #333; }
.part-desc { display: block; font-size: 13px; color: #666; margin-top: 4px; }

.search-hint {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  color: #333;
  font-weight: 500;
  padding: 0 16px;
  margin-bottom: 8px;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 16px;
  margin-bottom: 4px;
}

.selected-tag {
  flex: 1;
}

.search-result-list {
  height: calc(70vh - 120px);
  padding: 0 16px;
}

.search-result-item {
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.search-result-item:active {
  background-color: #f5f5f5;
}

.result-name {
  font-size: 16px;
  color: #333;
  font-weight: 500;
}

.result-desc {
  font-size: 13px;
  color: #999;
  margin-top: 4px;
}
