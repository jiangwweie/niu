<view class="container pb-safe">
  <view class="warning-banner">
    <t-icon name="info-circle" size="16" color="#0052d9" />
    <text>当前为草稿阶段，可维护费用明细。提交工单后将预占库存。</text>
  </view>

  <!-- Step 1: 基础信息 -->
  <view class="section" wx:if="{{step === 1}}">
    <view class="section-title">工单基础信息</view>

    <!-- Customer Search -->
    <view class="search-hint">
      <t-icon name="user" size="16" />
      <text>客户信息</text>
    </view>
    <view class="search-bar">
      <t-button size="small" theme="primary" variant="outline" bind:tap="openCustomerSearch">搜索已有客户</t-button>
      <view class="selected-tag" wx:if="{{selectedCustomerId}}">
        <t-tag theme="primary" variant="light" closable bind:close="clearSelectedCustomer">
          {{draft.customerNameSnapshot}}
        </t-tag>
      </view>
    </view>

    <!-- Vehicle Search -->
    <view class="search-hint" style="margin-top: 16px;">
      <t-icon name="car" size="16" />
      <text>车辆信息</text>
    </view>
    <view class="search-bar">
      <t-button size="small" theme="primary" variant="outline" bind:tap="openVehicleSearch">搜索已有车辆</t-button>
      <view class="selected-tag" wx:if="{{selectedVehicleId}}">
        <t-tag theme="primary" variant="light" closable bind:close="clearSelectedVehicle">
          {{draft.frameNoSnapshot}} {{draft.vehicleModelSnapshot}}
        </t-tag>
      </view>
    </view>

    <view style="margin-top: 12px; font-size: 12px; color: #999; padding: 0 4px;">
      也可直接在下方手工录入客户/车辆信息
    </view>

    <t-cell-group style="margin-top: 8px;">
      <t-input label="客户姓名" placeholder="必填" value="{{draft.customerNameSnapshot}}" bind:change="onDraftChange" data-field="customerNameSnapshot" align="right" />
      <t-input label="手机号" placeholder="选填" value="{{draft.customerPhoneSnapshot}}" bind:change="onDraftChange" data-field="customerPhoneSnapshot" align="right" />
      <t-input label="车型" placeholder="选填" value="{{draft.vehicleModelSnapshot}}" bind:change="onDraftChange" data-field="vehicleModelSnapshot" align="right" />
      <t-input label="车架号" placeholder="选填" value="{{draft.frameNoSnapshot}}" bind:change="onDraftChange" data-field="frameNoSnapshot" align="right" />
      <t-input label="电池号" placeholder="选填" value="{{draft.batteryNoSnapshot}}" bind:change="onDraftChange" data-field="batteryNoSnapshot" align="right" />
      <t-input label="维修项目" placeholder="必填" value="{{draft.repairItem}}" bind:change="onDraftChange" data-field="repairItem" align="right" />
      <t-input label="备注" placeholder="选填" value="{{draft.remark}}" bind:change="onDraftChange" data-field="remark" align="right" />
    </t-cell-group>

    <view class="action-bar">
      <t-button theme="primary" block size="large" bind:tap="saveDraft" loading="{{saving}}">保存草稿</t-button>
    </view>
  </view>

  <!-- Step 2: 费用明细 -->
  <view class="section" wx:if="{{step === 2}}">
    <view class="draft-summary">
      <view class="summary-header">
        <text class="wo-no">{{workOrder.workOrderNo || '草稿'}}</text>
        <t-tag theme="{{workOrder.status === 'DRAFT' ? 'primary' : 'success'}}" variant="light">{{statusText}}</t-tag>
      </view>
      <text class="summary-info">客户: {{workOrder.customerNameSnapshot}}</text>
      <text class="summary-info">项目: {{workOrder.repairItem}}</text>
    </view>

    <view class="section-title mt">费用明细</view>
    <view class="item-list" wx:if="{{workOrder.chargeItems && workOrder.chargeItems.length > 0}}">
      <view class="item-card" wx:for="{{workOrder.chargeItems}}" wx:key="id">
        <view class="item-header">
          <view class="item-title">
            <t-tag theme="default" variant="outline">{{item.chargeType === 'PART' ? '配件' : (item.chargeType === 'LABOR' ? '工时' : '其他')}}</t-tag>
            <text class="item-name">{{item.itemName}}</text>
          </view>
          <view class="item-actions" wx:if="{{workOrder.status === 'DRAFT'}}">
            <t-icon name="edit" size="20" color="#0052d9" bind:tap="editItem" data-item="{{item}}" />
            <t-icon name="delete" size="20" color="#e34d59" style="margin-left: 16px;" bind:tap="confirmDeleteItem" data-id="{{item.id}}" />
          </view>
        </view>
        <view class="item-body">
          <text class="item-desc" wx:if="{{item.chargeType === 'PART'}}">配件编码: {{item.partCodeSnapshot}}</text>
          <text class="item-desc">单价: ¥{{item.unitPrice}} x {{item.quantity}} {{item.unit || '-'}}</text>
          <text class="item-desc" wx:if="{{item.remark}}">备注: {{item.remark}}</text>
          <text class="item-amount">¥{{item.lineAmount}}</text>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>暂无费用明细</view>

    <view class="total-bar" wx:if="{{workOrder.chargeItems && workOrder.chargeItems.length > 0}}">
      <view style="display: flex; justify-content: space-between; width: 100%; margin-bottom: 8px;">
        <text>应收总计：</text>
        <text class="total-amount">¥{{workOrder.receivableAmount != null ? workOrder.receivableAmount : '0'}}</text>
      </view>
      <view style="display: flex; justify-content: space-between; width: 100%; font-size: 14px;">
        <text>已收金额：</text>
        <text style="color: #00a870;">¥{{workOrder.receivedAmount != null ? workOrder.receivedAmount : '0'}}</text>
      </view>
    </view>

    <view class="add-actions" wx:if="{{workOrder.status === 'DRAFT'}}">
      <t-button block theme="primary" variant="outline" icon="add" bind:tap="openAddItem" data-type="PART">添加配件费</t-button>
      <t-button block theme="default" variant="outline" icon="add" bind:tap="openAddItem" data-type="LABOR" style="margin-top: 12px;">添加工时费</t-button>
      <t-button block theme="default" variant="outline" icon="add" bind:tap="openAddItem" data-type="OTHER" style="margin-top: 12px;">添加其他费用</t-button>
    </view>

    <view class="submit-action" wx:if="{{workOrder.status === 'DRAFT'}}" style="margin-top: 24px; padding: 0 16px;">
      <view style="font-size: 12px; color: #666; margin-bottom: 12px; text-align: center;">
        提交后将预占库存，不会自动收款或结算。
      </view>
      <t-button block theme="danger" size="large" bind:tap="confirmSubmitWorkOrder" loading="{{submitLoading}}">提交工单</t-button>
    </view>

    <view class="cancel-action" wx:if="{{workOrder && workOrder.status !== 'SETTLED' && workOrder.status !== 'CANCELLED'}}" style="margin-top: {{workOrder.status === 'DRAFT' ? '12px' : '24px'}}; padding: 0 16px;">
      <view style="font-size: 12px; color: #666; margin-bottom: 12px; text-align: center;">
        取消后将释放预占库存。
      </view>
      <t-button block theme="default" variant="outline" size="large" bind:tap="openCancelDialog" loading="{{cancelLoading}}">取消工单</t-button>
    </view>

    <view class="payment-action" wx:if="{{workOrder && workOrder.status !== 'DRAFT' && workOrder.status !== 'CANCELLED' && workOrder.status !== 'SETTLED'}}" style="margin-top: 16px; padding: 0 16px;">
      <view style="font-size: 12px; color: #666; margin-bottom: 12px; text-align: center;">
        操作结果以系统校验为准。
      </view>
      <t-button block theme="primary" size="large" bind:tap="openPaymentDialog" loading="{{paymentLoading}}">记录收款</t-button>
    </view>

    <view class="refund-action" wx:if="{{workOrder && workOrder.status !== 'DRAFT' && workOrder.status !== 'CANCELLED' && workOrder.status !== 'SETTLED'}}" style="margin-top: 16px; padding: 0 16px;">
      <view style="font-size: 12px; color: #666; margin-bottom: 12px; text-align: center;">
        可退金额上限以系统校验为准。
      </view>
      <t-button block theme="danger" variant="outline" size="large" bind:tap="openRefundDialog" loading="{{refundLoading}}">记录退款</t-button>
    </view>

    <view class="settle-action" wx:if="{{workOrder && workOrder.status !== 'DRAFT' && workOrder.status !== 'CANCELLED' && workOrder.status !== 'SETTLED'}}" style="margin-top: 16px; margin-bottom: 24px; padding: 0 16px;">
      <view style="font-size: 12px; color: #666; margin-bottom: 12px; text-align: center;">
        结算后将正式扣减库存。
      </view>
      <t-button block theme="primary" variant="base" size="large" bind:tap="openSettleDialog" loading="{{settleLoading}}">结算工单</t-button>
    </view>
  </view>

  <!-- 添加/编辑 弹窗 -->
  <t-popup visible="{{itemPopupVisible}}" bind:visible-change="onPopupVisibleChange" placement="bottom">
    <view class="popup-header">
      <text class="popup-title">{{editingItemId ? '编辑费用明细' : '添加费用明细'}}</text>
      <t-icon name="close" size="24" bind:tap="closeItemPopup" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <t-cell-group>
        <block wx:if="{{currentItemForm.chargeType === 'PART' && !editingItemId}}">
          <t-cell title="选择配件" arrow bind:tap="openPartSelector" note="{{selectedPart ? selectedPart.partName : '请选择(必填)'}}" />
        </block>
        
        <t-input label="项目名称" placeholder="必填" value="{{currentItemForm.itemName}}" bind:change="onItemFormChange" data-field="itemName" align="right" />
        <t-input label="数量" type="number" placeholder="必填(>0)" value="{{currentItemForm.quantity}}" bind:change="onItemFormChange" data-field="quantity" align="right" />
        <t-input label="单位" placeholder="选填" value="{{currentItemForm.unit}}" bind:change="onItemFormChange" data-field="unit" align="right" />
        <t-input label="单价(元)" type="digit" placeholder="必填(>=0)" value="{{currentItemForm.unitPrice}}" bind:change="onItemFormChange" data-field="unitPrice" align="right" />
        <t-input label="备注" placeholder="选填" value="{{currentItemForm.remark}}" bind:change="onItemFormChange" data-field="remark" align="right" />
      </t-cell-group>
      
      <view class="popup-footer">
        <t-button theme="primary" block size="large" bind:tap="saveChargeItem" loading="{{savingItem}}">保存明细</t-button>
      </view>
    </scroll-view>
  </t-popup>

  <!-- 配件选择 弹窗 -->
  <t-popup visible="{{partSelectorVisible}}" placement="bottom" custom-style="height: 80vh; z-index: 12000;">
    <view class="popup-header">
      <text class="popup-title">选择配件</text>
      <t-icon name="close" size="24" bind:tap="closePartSelector" />
    </view>
    <t-search placeholder="搜索配件编码/名称" bind:change="onSearchPart" />
    <scroll-view scroll-y class="part-list">
      <view class="part-item" wx:for="{{partList}}" wx:key="id" bind:tap="selectPart" data-item="{{item}}">
        <view class="part-item-header">
          <text class="part-name">{{item.partName}}</text>
        </view>
        <text class="part-desc">编码: {{item.partCode}}</text>
      </view>
      <view class="empty-state" wx:if="{{partList.length === 0}}">暂无配件</view>
    </scroll-view>
  </t-popup>

  <t-dialog id="t-dialog" />
  
  <t-dialog
    visible="{{submitDialogVisible}}"
    title="提交工单"
    confirm-btn="确认提交"
    cancel-btn="取消"
    bind:confirm="onConfirmSubmit"
    bind:cancel="onCancelSubmit"
  >
    <view slot="content" style="font-size: 14px; color: #666;">
      <text style="display: block; margin-bottom: 12px;">提交工单后将预占库存，提交不会收款、不会结算。是否确认提交？</text>
      <t-input placeholder="可输入提交备注(选填)" value="{{submitRemark}}" bind:change="onSubmitRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
    </view>
  </t-dialog>

  <t-dialog
    visible="{{cancelDialogVisible}}"
    title="取消工单"
    confirm-btn="确认取消"
    cancel-btn="返回"
    bind:confirm="onConfirmCancel"
    bind:cancel="onCancelCancelDialog"
  >
    <view slot="content" style="font-size: 14px; color: #666;">
      <text style="display: block; margin-bottom: 12px;">确认取消工单吗？取消后将释放预占库存，但不会自动退款。</text>
      <t-input placeholder="请输入取消原因(必填)" value="{{cancelReason}}" bind:change="onCancelReasonChange" borderless style="background: #f5f5f5; border-radius: 4px; margin-bottom: 8px;" />
      <t-input placeholder="可输入备注(选填)" value="{{cancelRemark}}" bind:change="onCancelRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
    </view>
  </t-dialog>

  <t-popup visible="{{paymentDialogVisible}}" bind:visible-change="onPaymentPopupVisibleChange" placement="bottom">
    <view class="popup-header">
      <text class="popup-title">记录线下收款</text>
      <t-icon name="close" size="24" bind:tap="closePaymentDialog" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <view style="padding: 16px; background: #fff4e5; color: #d97100; font-size: 12px; margin-bottom: 16px;">
        注意：此处仅记录线下收款结果。
      </view>
      <t-cell-group>
        <t-input label="工单编号" value="{{workOrder.workOrderNo || '草稿'}}" align="right" readonly />
        <t-input label="应收总计" value="¥{{workOrder.receivableAmount != null ? workOrder.receivableAmount : '0'}}" align="right" readonly />
        <t-input label="已收金额" value="¥{{workOrder.receivedAmount != null ? workOrder.receivedAmount : '0'}}" align="right" readonly />
        <t-input label="收款金额" type="digit" placeholder="必填(>0)" value="{{paymentForm.amount}}" bind:change="onPaymentFormChange" data-field="amount" align="right" />
        
        <view style="padding: 16px; display: flex; align-items: center; justify-content: space-between;">
          <text style="font-size: 16px; color: #333;">收款方式</text>
        </view>
        <view style="padding: 0 16px 16px;">
          <view style="display: flex; flex-wrap: wrap; gap: 8px;">
            <t-tag theme="{{paymentForm.paymentMethod === 'WECHAT' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'WECHAT' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="WECHAT">微信</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'ALIPAY' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'ALIPAY' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="ALIPAY">支付宝</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'UNIONPAY' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'UNIONPAY' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="UNIONPAY">银联</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'CASH' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'CASH' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="CASH">现金</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'OTHER' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'OTHER' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="OTHER">其他</t-tag>
          </view>
        </view>
        
        <t-input label="备注" placeholder="选填" value="{{paymentForm.remark}}" bind:change="onPaymentFormChange" data-field="remark" align="right" />
      </t-cell-group>
      
      <view class="popup-footer">
        <t-button theme="primary" block size="large" bind:tap="confirmRecordPayment" loading="{{paymentLoading}}">确认收款</t-button>
      </view>
    </scroll-view>
  </t-popup>

  <t-popup visible="{{refundDialogVisible}}" bind:visible-change="onRefundPopupVisibleChange" placement="bottom">
    <view class="popup-header">
      <text class="popup-title">记录线下退款</text>
      <t-icon name="close" size="24" bind:tap="closeRefundDialog" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <view style="padding: 16px; background: #fff4e5; color: #d97100; font-size: 12px; margin-bottom: 16px;">
        注意：此处仅记录线下退款结果。
      </view>
      <t-cell-group>
        <t-input label="已收金额" value="¥{{workOrder.receivedAmount != null ? workOrder.receivedAmount : '0'}}" align="right" readonly />
        <t-input label="退款金额" type="digit" placeholder="必填(>0)" value="{{refundForm.amount}}" bind:change="onRefundFormChange" data-field="amount" align="right" />
        
        <view style="padding: 16px; display: flex; align-items: center; justify-content: space-between;">
          <text style="font-size: 16px; color: #333;">退款方式</text>
        </view>
        <view style="padding: 0 16px 16px;">
          <view style="display: flex; flex-wrap: wrap; gap: 8px;">
            <t-tag theme="{{refundForm.refundMethod === 'WECHAT' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'WECHAT' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="WECHAT">微信</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'ALIPAY' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'ALIPAY' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="ALIPAY">支付宝</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'UNIONPAY' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'UNIONPAY' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="UNIONPAY">银联</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'CASH' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'CASH' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="CASH">现金</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'OTHER' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'OTHER' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="OTHER">其他</t-tag>
          </view>
        </view>
        
        <t-input label="退款原因" placeholder="必填" value="{{refundForm.reason}}" bind:change="onRefundFormChange" data-field="reason" align="right" />
        <t-input label="备注" placeholder="选填" value="{{refundForm.remark}}" bind:change="onRefundFormChange" data-field="remark" align="right" />
      </t-cell-group>
      
      <view class="popup-footer">
        <t-button theme="danger" block size="large" bind:tap="confirmRecordRefund" loading="{{refundLoading}}">确认退款</t-button>
      </view>
    </scroll-view>
  </t-popup>

  <t-dialog
    visible="{{settleDialogVisible}}"
    title="结算工单"
    confirm-btn="确认结算"
    cancel-btn="返回"
    bind:confirm="onConfirmSettle"
    bind:cancel="onCancelSettleDialog"
  >
    <view slot="content" style="font-size: 14px; color: #666;">
      <text style="display: block; margin-bottom: 12px;">确认结算工单吗？结算后将正式扣减预占库存。</text>
      <t-input placeholder="可输入结算备注(选填)" value="{{settleRemark}}" bind:change="onSettleRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
    </view>
  </t-dialog>

  <!-- Customer Search Popup -->
  <t-popup visible="{{customerSearchVisible}}" bind:visible-change="onCustomerSearchPopupChange" placement="bottom" custom-style="height: 70vh; z-index: 11000;">
    <view class="popup-header">
      <text class="popup-title">搜索客户</text>
      <t-icon name="close" size="24" bind:tap="closeCustomerSearch" />
    </view>
    <view style="padding: 12px 16px; display: flex; gap: 8px;">
      <t-search placeholder="姓名或手机号" value="{{customerSearchKeyword}}" bind:change="onCustomerSearchInput" bind:submit="onCustomerSearch" />
    </view>
    <scroll-view scroll-y class="search-result-list">
      <view class="search-result-item" wx:for="{{customerSearchResults}}" wx:key="id" bind:tap="selectCustomer" data-item="{{item}}">
        <view class="result-name">{{item.customerName}}</view>
        <view class="result-desc">{{item.phone || '无手机号'}}</view>
      </view>
      <view class="empty-state" wx:if="{{customerSearchResults.length === 0 && customerSearchKeyword}}">未找到匹配客户</view>
      <view class="empty-state" wx:if="{{customerSearchResults.length === 0 && !customerSearchKeyword}}">输入姓名或手机号搜索</view>
    </scroll-view>
  </t-popup>

  <!-- Vehicle Search Popup -->
  <t-popup visible="{{vehicleSearchVisible}}" bind:visible-change="onVehicleSearchPopupChange" placement="bottom" custom-style="height: 70vh; z-index: 11000;">
    <view class="popup-header">
      <text class="popup-title">搜索车辆</text>
      <t-icon name="close" size="24" bind:tap="closeVehicleSearch" />
    </view>
    <view style="padding: 12px 16px; display: flex; gap: 8px;">
      <t-search placeholder="车架号/车型/客户手机号" value="{{vehicleSearchKeyword}}" bind:change="onVehicleSearchInput" bind:submit="onVehicleSearch" />
    </view>
    <scroll-view scroll-y class="search-result-list">
      <view class="search-result-item" wx:for="{{vehicleSearchResults}}" wx:key="id" bind:tap="selectVehicle" data-item="{{item}}">
        <view class="result-name">{{item.frameNo}}</view>
        <view class="result-desc">{{item.model || '-'}} | 车主: {{item.customerName}}</view>
      </view>
      <view class="empty-state" wx:if="{{vehicleSearchResults.length === 0 && vehicleSearchKeyword}}">未找到匹配车辆</view>
      <view class="empty-state" wx:if="{{vehicleSearchResults.length === 0 && !vehicleSearchKeyword}}">输入车架号/车型/客户手机号搜索</view>
    </scroll-view>
  </t-popup>

  <t-toast id="t-toast" />
</view>
