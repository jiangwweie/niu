page {
  background-color: #f5f6f8;
}

.container {
  padding: 24rpx 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 选择配件区 */
.select-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  border: 2rpx dashed #d0d0d0;
  margin-bottom: 16rpx;
}
.select-hint-text {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

.selected-part {
  background: #f0f7ff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 2rpx solid #b3d4ff;
  margin-bottom: 16rpx;
}

.part-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.part-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.part-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.stock-summary {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #333;
}

.inbound-state {
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f8f9fb;
  border: 2rpx solid #edf0f5;
}

.inbound-state-warning {
  background: #fff8e6;
  border-color: #ffd98c;
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.state-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #667085;
  word-break: break-all;
}

.scan-primary {
  margin-top: 20rpx;
}

.scan-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.action-button {
  flex: 1;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.action-secondary {
  background: #fff;
  border: 2rpx solid #d0d7e2;
  color: #1f2937;
}

.action-primary-outline {
  background: #f5f8ff;
  border: 2rpx solid #0052d9;
  color: #0052d9;
}

.selected-part-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}

.permission-hint {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  background: #f3f6fb;
  color: #5f6f89;
  font-size: 24rpx;
  line-height: 1.5;
}

.change-hint {
  font-size: 22rpx;
  color: #0052d9;
  margin-top: 12rpx;
  text-align: right;
}

/* 表单底部按钮 */
.page-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

/* 弹窗 */
.popup-header {
  padding: 28rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
}

.create-part-scroll {
  height: calc(85vh - 220rpx);
  padding: 24rpx;
  box-sizing: border-box;
}

.source-picker {
  padding: 24rpx 0;
}

.source-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.source-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.source-option {
  min-height: 128rpx;
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.source-option.active {
  border-color: #0052d9;
  background: #f0f6ff;
}

.source-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.source-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #6b7280;
}

.popup-footer {
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.part-list {
  height: calc(80vh - 160rpx);
}

.part-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.part-item-header {
  margin-bottom: 6rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 64rpx;
  font-size: 28rpx;
}

/* 成功结果 */
.success-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.success-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2ba471;
  margin-top: 24rpx;
}

.success-hint {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  margin-top: 12rpx;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.result-card {
  width: 100%;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.result-card .info {
  font-size: 26rpx;
  color: #444;
  margin-bottom: 12rpx;
}

.result-card .highlight {
  color: #2ba471;
  font-weight: bold;
  font-size: 28rpx;
}
