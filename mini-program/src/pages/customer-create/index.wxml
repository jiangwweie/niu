<view class="container">
  <view class="intro-card">
    <view class="intro-icon">
      <t-icon name="user-add" size="48rpx" color="#008d9e" />
    </view>
    <view class="intro-content">
      <text class="intro-title">客户录入</text>
      <text class="intro-desc">适合到店客户先建档，车辆信息可当场补充，也可后续在工单中填写。</text>
    </view>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">客户信息</text>
      <text class="section-tag">必填</text>
    </view>
    <t-input label="客户姓名" placeholder="必填" value="{{customerForm.customerName}}" bind:change="onCustomerFormChange" data-field="customerName" align="right" />
    <t-input label="手机号" type="number" placeholder="选填" value="{{customerForm.phone}}" bind:change="onCustomerFormChange" data-field="phone" align="right" />
    <t-input label="备注" placeholder="选填，如客户来源/特殊说明" value="{{customerForm.remark}}" bind:change="onCustomerFormChange" data-field="remark" align="right" />
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">车辆信息</text>
      <text class="section-tag optional">选填</text>
    </view>
    <view class="section-tip">填写任意车辆信息后，需要同时填写车架号，避免车辆档案无法唯一识别。</view>
    <view class="entry-input-row">
      <text class="entry-input-label">车型</text>
      <input class="entry-input-control" placeholder="输入车型" value="{{vehicleForm.model}}" bindinput="onVehicleFormChange" data-field="model" />
      <picker wx:if="{{vehicleModelOptions.length > 0}}" mode="selector" range="{{vehicleModelOptions}}" bindchange="onVehicleModelPickerChange">
        <view class="entry-input-action">选择</view>
      </picker>
      <view wx:else class="entry-input-action muted" bind:tap="showVehicleModelEmptyTip">选择</view>
    </view>
    <view class="scan-input-row">
      <text class="scan-input-label">车架号</text>
      <input class="scan-input-control" placeholder="可扫码或手动输入" value="{{vehicleForm.frameNo}}" bindinput="onVehicleFormChange" data-field="frameNo" />
      <view class="scan-input-action" aria-role="button" bind:tap="scanVehicleField" data-field="frameNo">
        <t-icon name="scan" size="32rpx" color="#0052d9" />
        <text>扫码</text>
      </view>
    </view>
    <view class="scan-input-row">
      <text class="scan-input-label">电池号</text>
      <input class="scan-input-control" placeholder="可扫码或手动输入" value="{{vehicleForm.batteryNo}}" bindinput="onVehicleFormChange" data-field="batteryNo" />
      <view class="scan-input-action" aria-role="button" bind:tap="scanVehicleField" data-field="batteryNo">
        <t-icon name="scan" size="32rpx" color="#0052d9" />
        <text>扫码</text>
      </view>
    </view>
    <t-input label="车辆备注" placeholder="选填" value="{{vehicleForm.remark}}" bind:change="onVehicleFormChange" data-field="remark" align="right" />
  </view>

  <view class="success-card" wx:if="{{successMessage}}">
    <t-icon name="check-circle" size="44rpx" color="#2ba471" />
    <view class="success-body">
      <text class="success-title">保存完成</text>
      <text class="success-text">{{successMessage}}</text>
    </view>
  </view>

  <view class="actions">
    <t-button theme="primary" block size="large" bind:tap="onSubmit" loading="{{submitLoading}}">保存客户</t-button>
    <view class="secondary-actions" wx:if="{{createdCustomerId}}">
      <t-button theme="primary" variant="outline" block bind:tap="goToCreateOrder">新建工单</t-button>
      <t-button theme="default" variant="outline" block bind:tap="onContinueCreate">继续录入</t-button>
      <t-button theme="default" variant="text" block bind:tap="backToDashboard">返回工作台</t-button>
    </view>
  </view>

  <t-toast id="t-toast" />
</view>
