.login-container {
  padding: 40px 20px;
  background-color: #f5f5f5;
  height: 100vh;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 40px;
}

.title {
  display: block;
  font-size: 24px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 14px;
  color: #666;
}

.form-container {
  background: #fff;
  padding: 20px 0;
  border-radius: 8px;
}

.login-btn {
  margin: 30px 20px 0;
}
