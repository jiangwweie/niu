.login-container {
  padding: 120rpx 60rpx;
  background-color: #fff;
  height: 100vh;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #df001f;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.form-container {
  background: #fff;
  padding: 0;
}

.login-btn {
  margin-top: 80rpx;
  border-radius: 12rpx !important;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #e5e5e5;
}

.divider-text {
  font-size: 24rpx;
  color: #999;
  padding: 0 24rpx;
}

.wechat-btn {
  border-radius: 12rpx !important;
}
