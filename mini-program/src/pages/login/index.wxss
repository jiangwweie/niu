.login-container {
  padding: 120rpx 60rpx;
  background-color: #fff;
  height: 100vh;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #008d9e;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.form-container {
  background: #fff;
  padding: 0;
}

.login-btn {
  margin-top: 64rpx;
  border-radius: 12rpx !important;
}

.captcha-row {
  display: grid;
  grid-template-columns: 1fr 220rpx;
  gap: 20rpx;
  align-items: center;
  margin-top: 24rpx;
}

.captcha-btn {
  border-radius: 12rpx !important;
  font-weight: 600;
}

.captcha-image {
  width: 180rpx;
  height: 54rpx;
  display: block;
}

.login-error {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff5f5;
  border: 1rpx solid #ffd8d8;
  border-radius: 12rpx;
  color: #c9353f;
  font-size: 26rpx;
  line-height: 1.5;
}

.divider {
  display: flex;
  align-items: center;
  margin: 48rpx 0 32rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #e5e5e5;
}

.divider-text {
  font-size: 24rpx;
  color: #999;
  padding: 0 24rpx;
}

.wechat-btn {
  border-radius: 12rpx !important;
}
