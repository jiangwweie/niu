/* ===== 库存页 ===== */
page {
  background: #f5f6f8;
}

.container {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 顶部工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 0;
}
.search-wrap {
  flex: 1;
  min-width: 0;
}

.scan-result-card {
  background: #fff;
  border: 2rpx solid #b3d4ff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin: 20rpx 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 列表 */
.list {
  padding: 20rpx 24rpx 0;
}

/* 库存卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.card-row-top {
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.part-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.part-code {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

/* 来源标签 */
.source-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.source-OFFICIAL { background: #fff3cd; color: #e37318; }
.source-THIRD_PARTY { background: #e8f0fe; color: #0052d9; }
/* 未知来源 fallback */
.source- { background: #f5f5f5; color: #999; }

/* 库存三列 */
.stock-row {
  display: flex;
  align-items: center;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 16rpx 0;
  margin-bottom: 12rpx;
}
.stock-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stock-divider {
  width: 2rpx;
  height: 40rpx;
  background: #eee;
}
.stock-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}
.stock-val {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.stock-normal { color: #2ba471; }
.stock-warning { color: #e37318; }
.stock-danger { color: #e33e33; }
.stock-reserved { color: #e37318; }

/* 预警提示 */
.stock-alert {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}
.stock-alert-danger {
  background: #fef2f2;
  color: #e33e33;
}
.stock-alert-warning {
  background: #fff8ec;
  color: #e37318;
}

.card-time {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-top: 4rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}
