.container {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f7fa;
  box-sizing: border-box;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.part-name {
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #1f2d3d;
  word-break: break-all;
}

.part-code {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a8794;
}

.hint {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f3f6f8;
  color: #5c6975;
  font-size: 26rpx;
  line-height: 1.5;
}

.state {
  padding: 120rpx 24rpx;
  text-align: center;
  color: #88939f;
  font-size: 28rpx;
}
