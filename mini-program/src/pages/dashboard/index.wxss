page {
  background-color: #f5f6f8;
}
.container {
  padding: 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 问候卡片 */
.header-card {
  background: linear-gradient(135deg, #008d9e, #00b4d8);
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 141, 158, 0.2);
}
.greeting {
  font-size: 38rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}
.subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

/* 快捷操作网格 */
.grid-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.action-item {
  width: calc(25% - 18rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}
.bg-primary { background-color: rgba(0, 141, 158, 0.08); }
.bg-success { background-color: rgba(43, 164, 113, 0.08); }
.bg-info    { background-color: rgba(0, 82, 217, 0.08); }
.bg-warning { background-color: rgba(227, 115, 24, 0.08); }
.action-name {
  font-size: 24rpx;
  color: #444;
  text-align: center;
}

/* 空状态 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

/* P0-01 fix: 工单提醒入口卡片 */
.notice-card {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #008d9e;
}
.notice-icon {
  flex-shrink: 0;
}
.notice-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.notice-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}
.notice-action {
  display: inline-flex;
}
.notice-link {
  font-size: 28rpx;
  color: #008d9e;
  font-weight: 600;
}
