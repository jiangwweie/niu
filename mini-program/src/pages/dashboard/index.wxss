page {
  background-color: #f5f6f8;
}
.container {
  padding: 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 问候卡片 */
.header-card {
  background: linear-gradient(135deg, #df001f, #ff4d4f);
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(223, 0, 31, 0.25);
}
.greeting {
  font-size: 38rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}
.subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

/* 快捷操作网格 */
.grid-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.action-item {
  width: calc(25% - 18rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.emoji-icon {
  font-size: 48rpx;
  line-height: 1;
}
.bg-primary { background-color: #df001f; }
.bg-success { background-color: #2BA471; }
.bg-info    { background-color: #0052D9; }
.bg-warning { background-color: #E37318; }
.action-name {
  font-size: 24rpx;
  color: #444;
  text-align: center;
}

/* 空状态 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
}
.empty-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}
