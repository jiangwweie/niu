.container {
  padding: 32rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}
.header-card {
  background: linear-gradient(135deg, #df001f, #ff4d4f);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(223, 0, 31, 0.2);
}
.greeting {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}
.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}
.section {
  margin-bottom: 40rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}
.grid-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}
.action-item {
  width: calc(25% - 18rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}
.bg-primary { background-color: #df001f; }
.bg-success { background-color: #2BA471; }
.bg-info { background-color: #0052D9; }
.bg-warning { background-color: #E37318; }
.action-name {
  font-size: 24rpx;
  color: #333;
}
.empty-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}
.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999;
}
