<view class="container">
  <!-- 问候卡片 -->
  <view class="header-card">
    <text class="greeting">{{greeting}}，{{userName}} 👋</text>
    <text class="subtitle">门店售后工作台</text>
  </view>

  <!-- 快捷操作 -->
  <view class="section">
    <text class="section-title">快捷操作</text>
    <view class="grid-actions">
      <view class="action-item" wx:if="{{hasCreateOrderPermission}}" bindtap="goToCreateOrder">
        <view class="icon-wrap bg-primary">
          <view class="emoji-icon">🔧</view>
        </view>
        <text class="action-name">新建工单</text>
      </view>
      <view class="action-item" wx:if="{{hasInboundPermission}}" bindtap="goToInbound">
        <view class="icon-wrap bg-success">
          <view class="emoji-icon">📦</view>
        </view>
        <text class="action-name">配件入库</text>
      </view>
      <view class="action-item" bindtap="goToInventory">
        <view class="icon-wrap bg-info">
          <view class="emoji-icon">🗄️</view>
        </view>
        <text class="action-name">查库存</text>
      </view>
      <view class="action-item" wx:if="{{hasReimbursementPermission}}" bindtap="goToReimbursement">
        <view class="icon-wrap bg-warning">
          <view class="emoji-icon">💰</view>
        </view>
        <text class="action-name">报销申请</text>
      </view>
    </view>
  </view>

  <!-- 工单快速入口（P0-01 fix: 移除静态误导性"无待办"提示，改为中性引导） -->
  <view class="section">
    <text class="section-title">工单提醒</text>
    <view class="notice-card">
      <view class="notice-icon">📋</view>
      <view class="notice-body">
        <text class="notice-text">请前往工单列表查看当前待处理工单。</text>
        <view class="notice-action" bindtap="goToWorkOrders">
          <text class="notice-link">查看全部工单 →</text>
        </view>
      </view>
    </view>
  </view>
</view>
