<view class="container pb-safe">
  <view class="warning-banner">
    <t-icon name="info-circle" size="16" color="#0052d9" />
    <text>当前为草稿阶段，可维护费用明细。提交工单后进入维修中，并预占相关库存。</text>
  </view>

  <!-- Step 1: 基础信息 -->
  <view class="section" wx:if="{{step === 1}}">
    <view class="section-title">工单基础信息</view>

    <!-- Customer Search -->
    <view class="search-hint">
      <t-icon name="user" size="16" />
      <text>客户信息</text>
    </view>
    <view class="search-bar">
      <t-button size="small" theme="primary" variant="outline" bind:tap="openCustomerSearch">搜索已有客户</t-button>
      <view class="selected-tag" wx:if="{{selectedCustomerId}}">
        <t-tag theme="primary" variant="light" closable bind:close="clearSelectedCustomer">
          {{draft.customerNameSnapshot}}
        </t-tag>
      </view>
    </view>

    <!-- Vehicle Search -->
    <view class="search-hint search-hint-spaced">
      <t-icon name="car" size="16" />
      <text>车辆信息</text>
    </view>
    <view class="search-bar">
      <t-button size="small" theme="primary" variant="outline" bind:tap="openVehicleSearch">搜索已有车辆</t-button>
      <view class="selected-tag" wx:if="{{selectedVehicleId}}">
        <t-tag theme="primary" variant="light" closable bind:close="clearSelectedVehicle">
          {{draft.frameNoSnapshot}} {{draft.vehicleModelSnapshot}}
        </t-tag>
      </view>
    </view>

    <view class="manual-entry-hint">
      也可直接在下方手工录入客户/车辆信息
    </view>

    <t-cell-group class="draft-form-group">
      <t-input label="客户姓名" placeholder="必填" value="{{draft.customerNameSnapshot}}" bind:change="onDraftChange" data-field="customerNameSnapshot" align="right" />
      <t-input label="手机号" placeholder="选填" value="{{draft.customerPhoneSnapshot}}" bind:change="onDraftChange" data-field="customerPhoneSnapshot" align="right" />
      <view class="niu-form-row">
        <text class="niu-form-label">车型</text>
        <input class="niu-form-input" placeholder="输入车型" value="{{draft.vehicleModelSnapshot}}" bindinput="onDraftChange" data-field="vehicleModelSnapshot" />
        <picker wx:if="{{vehicleModelOptions.length > 0}}" mode="selector" range="{{vehicleModelOptions}}" bindchange="onDraftVehicleModelPickerChange">
          <view class="niu-form-action">选择</view>
        </picker>
        <view wx:else class="niu-form-action muted" bind:tap="showDraftPickerEmptyTip" data-label="车型">选择</view>
      </view>
      <view class="scan-input-row">
        <text class="scan-input-label">车架号</text>
        <input class="scan-input-control" placeholder="可扫码或手动输入" value="{{draft.frameNoSnapshot}}" bindinput="onDraftChange" data-field="frameNoSnapshot" />
        <view class="scan-input-action" aria-role="button" bind:tap="scanDraftVehicleField" data-field="frameNoSnapshot">
          <t-icon name="scan" size="32rpx" color="#0052d9" />
          <text>扫码</text>
        </view>
      </view>
      <view class="scan-input-row">
        <text class="scan-input-label">电池号</text>
        <input class="scan-input-control" placeholder="可扫码或手动输入" value="{{draft.batteryNoSnapshot}}" bindinput="onDraftChange" data-field="batteryNoSnapshot" />
        <view class="scan-input-action" aria-role="button" bind:tap="scanDraftVehicleField" data-field="batteryNoSnapshot">
          <t-icon name="scan" size="32rpx" color="#0052d9" />
          <text>扫码</text>
        </view>
      </view>
      <view class="niu-form-row">
        <text class="niu-form-label">维修项目</text>
        <input class="niu-form-input" placeholder="输入项目" value="{{draft.repairItem}}" bindinput="onDraftChange" data-field="repairItem" />
        <picker wx:if="{{repairItemOptions.length > 0}}" mode="selector" range="{{repairItemOptions}}" bindchange="onDraftRepairItemPickerChange">
          <view class="niu-form-action">选择</view>
        </picker>
        <view wx:else class="niu-form-action muted" bind:tap="showDraftPickerEmptyTip" data-label="维修项目">选择</view>
      </view>
      <t-input label="备注" placeholder="选填" value="{{draft.remark}}" bind:change="onDraftChange" data-field="remark" align="right" />
    </t-cell-group>

    <view class="action-bar">
      <t-button wx:if="{{workOrderId}}" theme="default" block size="large" bind:tap="backToChargeItems">返回费用明细</t-button>
      <view wx:if="{{workOrderId}}" style="height: 12px;"></view>
      <t-button theme="primary" block size="large" bind:tap="saveDraft" loading="{{saving}}">{{workOrderId ? '保存修改' : '保存草稿'}}</t-button>
    </view>
  </view>

  <!-- Step 2: 费用明细 & 操作 -->
  <view class="section" wx:if="{{step === 2}}">
    <view class="draft-summary">
      <view class="summary-header">
        <text class="wo-no">{{workOrder.workOrderNo || '草稿'}}</text>
        <t-tag theme="{{workOrder.progressStatus === 'DRAFT' ? 'primary' : 'success'}}" variant="light">{{statusText}}</t-tag>
      </view>
      <view class="status-pills" wx:if="{{workOrder.cashierStatusText || workOrder.inventoryStatusText}}">
        <t-tag wx:if="{{workOrder.cashierStatusText}}" theme="default" variant="outline" size="small">{{workOrder.cashierStatusText}}</t-tag>
        <t-tag wx:if="{{workOrder.inventoryStatusText}}" theme="default" variant="outline" size="small">{{workOrder.inventoryStatusText}}</t-tag>
      </view>
      <text class="summary-info">客户: {{workOrder.customerNameSnapshot}}</text>
      <text class="summary-info">项目: {{workOrder.repairItem}}</text>
      <view class="draft-summary-actions" wx:if="{{workOrder.progressStatus === 'DRAFT'}}">
        <t-button size="small" theme="primary" variant="outline" bind:tap="editDraftInfo">编辑基础信息</t-button>
      </view>
    </view>

    <view class="section-title mt">费用明细</view>
    <view class="item-list" wx:if="{{workOrder.chargeItems && workOrder.chargeItems.length > 0}}">
      <view class="item-card" wx:for="{{workOrder.chargeItems}}" wx:key="id">
        <view class="item-header">
          <view class="item-title">
            <t-tag theme="default" variant="outline">{{item.chargeType === 'PART' ? '配件' : (item.chargeType === 'LABOR' ? '工时' : '其他')}}</t-tag>
            <text class="item-name">{{item.itemName}}</text>
          </view>
          <view class="item-actions" wx:if="{{workOrder.progressStatus === 'DRAFT'}}">
            <t-icon name="edit" size="20" color="#0052d9" bind:tap="editItem" data-item="{{item}}" />
            <t-icon name="delete" size="20" color="#e34d59" style="margin-left: 16px;" bind:tap="confirmDeleteItem" data-id="{{item.id}}" />
          </view>
        </view>
        <view class="item-body">
          <text class="item-desc" wx:if="{{item.chargeType === 'PART'}}">配件编码: {{item.partCodeSnapshot}}</text>
          <text class="item-desc">单价: ¥{{item.unitPrice}} x {{item.quantity}} {{item.unit || '-'}}</text>
          <text class="item-desc" wx:if="{{item.remark}}">备注: {{item.remark}}</text>
          <text class="item-amount">¥{{item.lineAmount}}</text>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>暂无费用明细</view>

    <view class="total-bar" wx:if="{{workOrder.chargeItems && workOrder.chargeItems.length > 0}}">
      <view style="display: flex; justify-content: space-between; width: 100%; margin-bottom: 8px;">
        <text>应收总计：</text>
        <text class="total-amount">¥{{workOrder.receivableAmount != null ? workOrder.receivableAmount : '0'}}</text>
      </view>
      <view style="display: flex; justify-content: space-between; width: 100%; font-size: 14px;">
        <text>已收金额：</text>
        <text style="color: #00a870;">¥{{workOrder.netReceived != null ? workOrder.netReceived : workOrder.receivedAmount != null ? workOrder.receivedAmount : '0'}}</text>
      </view>
    </view>

    <!-- 添加费用明细 (DRAFT only) -->
    <view class="niu-action-grid add-actions" wx:if="{{workOrder.progressStatus === 'DRAFT'}}">
      <view class="niu-action-tile primary" aria-role="button" bind:tap="openAddItem" data-type="PART">
        <t-icon name="add-circle" size="40rpx" color="#0052d9" />
        <text>配件费</text>
      </view>
      <view class="niu-action-tile" aria-role="button" bind:tap="openAddItem" data-type="LABOR">
        <t-icon name="add-circle" size="40rpx" color="#344054" />
        <text>工时费</text>
      </view>
      <view class="niu-action-tile" aria-role="button" bind:tap="openAddItem" data-type="OTHER">
        <t-icon name="add-circle" size="40rpx" color="#344054" />
        <text>其他费用</text>
      </view>
    </view>

    <!-- 提交工单 (DRAFT only) -->
    <view class="primary-flow-action" wx:if="{{workOrder.progressStatus === 'DRAFT'}}">
      <view class="action-hint">提交后进入维修中，并预占相关库存。</view>
      <t-button block theme="danger" size="large" bind:tap="confirmSubmitWorkOrder" loading="{{submitLoading}}">提交工单</t-button>
    </view>

    <!-- 标记维修完成 -->
    <view class="primary-flow-action" wx:if="{{workOrder.canMarkRepairDone}}">
      <view class="action-hint">标记维修完成后，工单配件库存将正式扣减。</view>
      <t-button block theme="primary" size="large" bind:tap="openMarkRepairDoneDialog" loading="{{markRepairDoneLoading}}">标记维修完成</t-button>
    </view>

    <!-- 交付关闭 -->
    <view class="primary-flow-action" wx:if="{{workOrder.canDeliver}}">
      <t-button block theme="primary" size="large" bind:tap="openDeliverDialog" loading="{{deliverLoading}}">交付关闭</t-button>
    </view>

    <!-- 取消工单 -->
    <view class="secondary-flow-action" wx:if="{{workOrder.canCancel}}">
      <t-button block theme="default" variant="outline" size="large" bind:tap="openCancelDialog" loading="{{cancelLoading}}">取消工单</t-button>
    </view>

    <!-- 记录收款 -->
    <view class="primary-flow-action" wx:if="{{canShowRecordPayment}}">
      <view class="action-hint">收款不改变工单进度状态。</view>
      <t-button block theme="primary" size="large" bind:tap="openPaymentDialog" loading="{{paymentLoading}}">记录收款</t-button>
    </view>
    <view class="paid-hint" wx:if="{{showPaidInFullHint}}">
      已收齐
    </view>

    <!-- 记录退款 -->
    <view class="secondary-flow-action" wx:if="{{canShowRecordRefund}}">
      <view class="action-hint">退款上限以系统校验为准。</view>
      <t-button block theme="danger" variant="outline" size="large" bind:tap="openRefundDialog" loading="{{refundLoading}}">记录退款</t-button>
    </view>
  </view>

  <!-- 添加/编辑 弹窗 -->
  <t-popup visible="{{itemPopupVisible}}" bind:visible-change="onPopupVisibleChange" placement="bottom">
    <view class="popup-header">
      <text class="popup-title">{{editingItemId ? '编辑费用明细' : '添加费用明细'}}</text>
      <t-icon name="close" size="24" bind:tap="closeItemPopup" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <t-cell-group>
        <block wx:if="{{currentItemForm.chargeType === 'PART' && !editingItemId}}">
          <t-cell title="选择配件" arrow bind:tap="openPartSelector" note="{{selectedPart ? selectedPart.partName : '请选择(必填)'}}" />
          <view class="scan-part-actions">
            <t-button theme="primary" variant="outline" icon="scan" size="small" bind:tap="scanPartForChargeItem">扫码选件</t-button>
            <t-button theme="default" variant="outline" size="small" bind:tap="openTempPartDialog">临时新增配件</t-button>
          </view>
          <view class="selected-part-panel" wx:if="{{selectedPart}}">
            <text class="part-desc">编码: {{selectedPart.partCode}}</text>
            <text class="part-desc" wx:if="{{selectedPart.defaultBarcode}}">条码: {{selectedPart.defaultBarcode}}</text>
            <text class="part-desc" wx:if="{{selectedPart.model}}">型号: {{selectedPart.model}}</text>
            <text class="part-desc" wx:if="{{selectedPartStock && selectedPartStock.hasStockRecord}}">库存: 可用 {{selectedPartStock.availableQty}} / 实际 {{selectedPartStock.actualQty}} / 预占 {{selectedPartStock.reservedQty}}</text>
            <text class="part-desc" wx:if="{{selectedPartStock && !selectedPartStock.hasStockRecord}}" style="color: #e34d59;">暂无库存记录</text>
          </view>
        </block>

        <t-input label="项目名称" placeholder="{{currentItemForm.chargeType === 'PART' ? '选择配件后自动带出' : '必填'}}" value="{{currentItemForm.itemName}}" bind:change="onItemFormChange" data-field="itemName" align="right" readonly="{{currentItemForm.chargeType === 'PART'}}" />
        <t-input label="数量" type="number" placeholder="必填(>0)" value="{{currentItemForm.quantity}}" bind:change="onItemFormChange" data-field="quantity" align="right" />
        <t-input label="单位" placeholder="选填" value="{{currentItemForm.unit}}" bind:change="onItemFormChange" data-field="unit" align="right" />
        <view class="option-row" wx:if="{{unitOptions.length > 0}}">
          <t-tag
            wx:for="{{unitOptions}}"
            wx:key="*this"
            theme="{{currentItemForm.unit === item ? 'primary' : 'default'}}"
            variant="{{currentItemForm.unit === item ? 'light' : 'outline'}}"
            bind:tap="onSelectItemOption"
            data-field="unit"
            data-value="{{item}}"
          >{{item}}</t-tag>
        </view>
        <t-input label="单价(元)" type="digit" placeholder="必填(>=0)" value="{{currentItemForm.unitPrice}}" bind:change="onItemFormChange" data-field="unitPrice" align="right" />
        <t-input label="备注" placeholder="选填" value="{{currentItemForm.remark}}" bind:change="onItemFormChange" data-field="remark" align="right" />
      </t-cell-group>

      <view class="popup-footer">
        <t-button theme="primary" block size="large" bind:tap="saveChargeItem" loading="{{savingItem}}">保存明细</t-button>
      </view>
    </scroll-view>
  </t-popup>

  <!-- 配件选择 弹窗 -->
  <t-popup visible="{{partSelectorVisible}}" placement="bottom" z-index="12000" custom-style="height: 80vh;">
    <view class="popup-header">
      <text class="popup-title">选择配件</text>
      <t-icon name="close" size="24" bind:tap="closePartSelector" />
    </view>
    <t-search placeholder="搜索配件编码、名称、官方品号" bind:change="onSearchPart" />
    <scroll-view scroll-y class="part-list">
      <view class="part-item" wx:for="{{partList}}" wx:key="id" bind:tap="selectPart" data-item="{{item}}">
        <view class="part-item-header">
          <text class="part-name">{{item.partName}}</text>
        </view>
        <text class="part-desc">编码: {{item.partCode}}</text>
      </view>
      <view class="empty-state" wx:if="{{partList.length === 0}}">暂无配件</view>
    </scroll-view>
  </t-popup>

  <!-- 临时新增配件弹窗 -->
  <t-popup visible="{{tempPartDialogVisible}}" bind:visible-change="onTempPartPopupVisibleChange" placement="bottom">
    <view class="popup-header">
      <text class="popup-title">临时新增配件</text>
      <t-icon name="close" size="24" bind:tap="closeTempPartDialog" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <t-cell-group>
        <t-input label="配件名称" placeholder="必填" value="{{tempPartForm.partName}}" bind:change="onTempPartFormChange" data-field="partName" align="right" />
        <t-input label="条码" placeholder="扫码值/选填" value="{{tempPartForm.barcode}}" bind:change="onTempPartFormChange" data-field="barcode" align="right" />
        <t-input label="型号" placeholder="选填" value="{{tempPartForm.model}}" bind:change="onTempPartFormChange" data-field="model" align="right" />
        <view class="niu-form-row">
          <text class="niu-form-label">分类</text>
          <input class="niu-form-input" placeholder="输入分类" value="{{tempPartForm.categoryCode}}" bindinput="onTempPartFormChange" data-field="categoryCode" />
          <picker wx:if="{{partCategoryOptions.length > 0}}" mode="selector" range="{{partCategoryOptions}}" bindchange="onTempPartCategoryPickerChange">
            <view class="niu-form-action">选择</view>
          </picker>
          <view wx:else class="niu-form-action muted" bind:tap="showDraftPickerEmptyTip" data-label="配件分类">选择</view>
        </view>
        <t-input label="数量" type="number" placeholder="必填(>0)" value="{{tempPartForm.quantity}}" bind:change="onTempPartFormChange" data-field="quantity" align="right" />
        <t-input label="单位" placeholder="选填" value="{{tempPartForm.unit}}" bind:change="onTempPartFormChange" data-field="unit" align="right" />
        <view class="option-row" wx:if="{{unitOptions.length > 0}}">
          <t-tag
            wx:for="{{unitOptions}}"
            wx:key="*this"
            theme="{{tempPartForm.unit === item ? 'primary' : 'default'}}"
            variant="{{tempPartForm.unit === item ? 'light' : 'outline'}}"
            bind:tap="onSelectTempPartOption"
            data-field="unit"
            data-value="{{item}}"
          >{{item}}</t-tag>
        </view>
        <t-input label="销售单价" type="digit" placeholder="必填(>=0)" value="{{tempPartForm.unitPrice}}" bind:change="onTempPartFormChange" data-field="unitPrice" align="right" />
        <t-input label="单位成本" type="digit" placeholder="选填(>=0)" value="{{tempPartForm.unitCost}}" bind:change="onTempPartFormChange" data-field="unitCost" align="right" />
        <t-input label="库位" placeholder="选填" value="{{tempPartForm.locationRemark}}" bind:change="onTempPartFormChange" data-field="locationRemark" align="right" />
        <t-input label="备注" placeholder="选填" value="{{tempPartForm.remark}}" bind:change="onTempPartFormChange" data-field="remark" align="right" />
      </t-cell-group>
      <view class="popup-footer">
        <t-button theme="primary" block size="large" bind:tap="submitTempPartCharge" loading="{{tempPartSaving}}">入库并加入工单</t-button>
      </view>
    </scroll-view>
  </t-popup>

  <t-dialog id="t-dialog" />

  <!-- 提交工单对话框 -->
  <t-dialog
    visible="{{submitDialogVisible}}"
    title="提交工单"
    confirm-btn="确认提交"
    cancel-btn="取消"
    bind:confirm="onConfirmSubmit"
    bind:cancel="onCancelSubmit"
  >
    <view slot="content" style="font-size: 14px; color: #666;">
      <text style="display: block; margin-bottom: 12px;">提交后进入维修中，并预占相关库存。是否确认提交？</text>
      <t-input placeholder="可输入提交备注(选填)" value="{{submitRemark}}" bind:change="onSubmitRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
    </view>
  </t-dialog>

  <!-- 取消工单对话框 -->
  <t-dialog
    visible="{{cancelDialogVisible}}"
    title="取消工单"
    confirm-btn="确认取消"
    cancel-btn="返回"
    bind:confirm="onConfirmCancel"
    bind:cancel="onCancelCancelDialog"
  >
    <view slot="content" style="font-size: 14px; color: #666;">
      <text style="display: block; margin-bottom: 12px;">取消工单将关闭此工单；如已预占库存，系统将自动释放。若已有收款，请后续处理退款。</text>
      <view class="dialog-form-row">
        <input class="dialog-form-input" placeholder="请输入取消原因(必填)" value="{{cancelReason}}" bindinput="onCancelReasonChange" />
        <picker wx:if="{{cancelReasonOptions.length > 0}}" mode="selector" range="{{cancelReasonOptions}}" bindchange="onCancelReasonPickerChange">
          <view class="dialog-form-action">选择</view>
        </picker>
      </view>
      <t-input placeholder="可输入备注(选填)" value="{{cancelRemark}}" bind:change="onCancelRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
    </view>
  </t-dialog>

  <!-- 记录收款弹窗 -->
  <t-popup visible="{{paymentDialogVisible}}" bind:visible-change="onPaymentPopupVisibleChange" placement="bottom">
    <view class="popup-header">
      <text class="popup-title">记录线下收款</text>
      <t-icon name="close" size="24" bind:tap="closePaymentDialog" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <view style="padding: 16px; background: #fff4e5; color: #d97100; font-size: 12px; margin-bottom: 16px;">
        注意：此处仅记录线下收款结果。收款不改变工单进度状态。
      </view>
      <t-cell-group>
        <t-input label="工单编号" value="{{workOrder.workOrderNo || '草稿'}}" align="right" readonly />
        <t-input label="应收总计" value="¥{{workOrder.receivableAmount != null ? workOrder.receivableAmount : '0'}}" align="right" readonly />
        <t-input label="已收金额" value="¥{{workOrder.netReceived != null ? workOrder.netReceived : workOrder.receivedAmount != null ? workOrder.receivedAmount : '0'}}" align="right" readonly />
        <t-input label="待收金额" value="¥{{outstandingAmountStr}}" align="right" readonly />
        <t-input label="收款金额" type="digit" placeholder="{{outstandingAmount > 0 ? '不超过待收¥' + outstandingAmountStr : '已收齐'}}" value="{{paymentForm.amount}}" bind:change="onPaymentFormChange" data-field="amount" align="right" />

        <view style="padding: 16px; display: flex; align-items: center; justify-content: space-between;">
          <text style="font-size: 16px; color: #333;">收款方式</text>
        </view>
        <view style="padding: 0 16px 16px;">
          <view style="display: flex; flex-wrap: wrap; gap: 8px;">
            <t-tag theme="{{paymentForm.paymentMethod === 'WECHAT' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'WECHAT' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="WECHAT">微信</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'ALIPAY' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'ALIPAY' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="ALIPAY">支付宝</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'UNIONPAY' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'UNIONPAY' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="UNIONPAY">银联</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'CASH' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'CASH' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="CASH">现金</t-tag>
            <t-tag theme="{{paymentForm.paymentMethod === 'OTHER' ? 'primary' : 'default'}}" variant="{{paymentForm.paymentMethod === 'OTHER' ? 'light' : 'outline'}}" bind:tap="onSelectPaymentMethod" data-val="OTHER">其他</t-tag>
          </view>
        </view>

        <t-input label="备注" placeholder="选填" value="{{paymentForm.remark}}" bind:change="onPaymentFormChange" data-field="remark" align="right" />
      </t-cell-group>

      <view class="popup-footer">
        <t-button theme="primary" block size="large" bind:tap="confirmRecordPayment" loading="{{paymentLoading}}">确认收款</t-button>
      </view>
    </scroll-view>
  </t-popup>

  <!-- 记录退款弹窗 -->
  <t-popup visible="{{refundDialogVisible}}" bind:visible-change="onRefundPopupVisibleChange" placement="bottom">
    <view class="popup-header">
      <text class="popup-title">记录线下退款</text>
      <t-icon name="close" size="24" bind:tap="closeRefundDialog" />
    </view>
    <scroll-view scroll-y class="popup-body">
      <view style="padding: 16px; background: #fff4e5; color: #d97100; font-size: 12px; margin-bottom: 16px;">
        注意：此处仅记录线下退款结果。
      </view>
      <t-cell-group>
        <t-input label="可退金额" value="¥{{refundableAmountStr}}" align="right" readonly />
        <t-input label="退款金额" type="digit" placeholder="{{refundableAmount > 0 ? '不超过可退 ¥' + refundableAmountStr : '无可退金额'}}" value="{{refundForm.amount}}" bind:change="onRefundFormChange" data-field="amount" align="right" />

        <view style="padding: 16px; display: flex; align-items: center; justify-content: space-between;">
          <text style="font-size: 16px; color: #333;">退款方式</text>
        </view>
        <view style="padding: 0 16px 16px;">
          <view style="display: flex; flex-wrap: wrap; gap: 8px;">
            <t-tag theme="{{refundForm.refundMethod === 'WECHAT' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'WECHAT' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="WECHAT">微信</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'ALIPAY' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'ALIPAY' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="ALIPAY">支付宝</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'UNIONPAY' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'UNIONPAY' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="UNIONPAY">银联</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'CASH' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'CASH' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="CASH">现金</t-tag>
            <t-tag theme="{{refundForm.refundMethod === 'OTHER' ? 'danger' : 'default'}}" variant="{{refundForm.refundMethod === 'OTHER' ? 'light' : 'outline'}}" bind:tap="onSelectRefundMethod" data-val="OTHER">其他</t-tag>
          </view>
        </view>

        <view class="niu-form-row">
          <text class="niu-form-label">退款原因</text>
          <input class="niu-form-input" placeholder="输入原因" value="{{refundForm.reason}}" bindinput="onRefundFormChange" data-field="reason" />
          <picker wx:if="{{refundReasonOptions.length > 0}}" mode="selector" range="{{refundReasonOptions}}" bindchange="onRefundReasonPickerChange">
            <view class="niu-form-action">选择</view>
          </picker>
          <view wx:else class="niu-form-action muted" bind:tap="showDraftPickerEmptyTip" data-label="退款原因">选择</view>
        </view>
        <t-input label="备注" placeholder="选填" value="{{refundForm.remark}}" bind:change="onRefundFormChange" data-field="remark" align="right" />
      </t-cell-group>

      <view class="popup-footer">
        <t-button theme="danger" block size="large" bind:tap="confirmRecordRefund" loading="{{refundLoading}}">确认退款</t-button>
      </view>
    </scroll-view>
  </t-popup>

  <!-- 标记维修完成对话框 -->
  <t-dialog
    visible="{{markRepairDoneDialogVisible}}"
    title="标记维修完成"
    confirm-btn="确认"
    cancel-btn="返回"
    bind:confirm="onConfirmMarkRepairDone"
    bind:cancel="onCancelMarkRepairDone"
  >
    <view slot="content" style="font-size: 14px; color: #666;">
      <text style="display: block; margin-bottom: 12px;">标记维修完成后，工单配件库存将正式扣减，不能再普通取消工单。</text>
      <block wx:if="{{workOrder.receivableAmount <= 0}}">
        <text class="dialog-section-label">应收为 0，请选择无需收款原因：</text>
        <view class="dialog-form-row">
          <input class="dialog-form-input" placeholder="无需收款原因(必填)" value="{{noChargeReason}}" bindinput="onNoChargeReasonChange" />
          <picker wx:if="{{noChargeReasons.length > 0}}" mode="selector" range="{{noChargeReasons}}" bindchange="onNoChargeReasonPickerChange">
            <view class="dialog-form-action">选择</view>
          </picker>
        </view>
        <t-input placeholder="无需收款备注(选填)" value="{{noChargeRemark}}" bind:change="onNoChargeRemarkChange" borderless style="background: #f5f5f5; border-radius: 4px;" />
      </block>
    </view>
  </t-dialog>

  <!-- 交付关闭对话框 -->
  <t-dialog
    visible="{{deliverDialogVisible}}"
    title="确认交付关闭"
    confirm-btn="确认交付"
    cancel-btn="返回"
    bind:confirm="onConfirmDeliver"
    bind:cancel="onCancelDeliver"
  >
    <view slot="content" style="font-size: 14px; color: #666;">
      <text style="display: block; margin-bottom: 12px;">{{deliverConfirmText}}</text>
    </view>
  </t-dialog>

  <!-- Customer Search Popup -->
  <t-popup visible="{{customerSearchVisible}}" bind:visible-change="onCustomerSearchPopupChange" placement="bottom" custom-style="height: 70vh;">
    <view class="popup-header">
      <text class="popup-title">搜索客户</text>
      <t-icon name="close" size="24" bind:tap="closeCustomerSearch" />
    </view>
    <view class="popup-search-row">
      <t-search class="popup-search" placeholder="姓名或手机号" value="{{customerSearchKeyword}}" bind:change="onCustomerSearchInput" bind:submit="onCustomerSearch" />
      <t-button size="small" theme="primary" bind:tap="onCustomerSearch">搜索</t-button>
    </view>
    <scroll-view scroll-y class="search-result-list">
      <view class="result-section-title" wx:if="{{customerSearchState === 'recent'}}">最近客户</view>
      <view class="search-result-item" wx:for="{{customerSearchResults}}" wx:key="id" bind:tap="selectCustomer" data-item="{{item}}">
        <view class="result-name">{{item.customerName}}</view>
        <view class="result-desc">{{item.phone || '无手机号'}}</view>
      </view>
      <view class="empty-state" wx:if="{{customerSearchState === 'loading'}}">搜索中</view>
      <view class="empty-state" wx:if="{{customerSearchState === 'empty'}}">未找到客户，可手动填写新客户信息</view>
      <view class="empty-state" wx:if="{{customerSearchState === 'error'}}">客户搜索失败，请稍后重试</view>
      <view class="empty-state" wx:if="{{customerSearchState === 'idle'}}">输入姓名或手机号搜索客户</view>
    </scroll-view>
  </t-popup>

  <!-- Vehicle Search Popup -->
  <t-popup visible="{{vehicleSearchVisible}}" bind:visible-change="onVehicleSearchPopupChange" placement="bottom" custom-style="height: 70vh;">
    <view class="popup-header">
      <text class="popup-title">搜索车辆</text>
      <t-icon name="close" size="24" bind:tap="closeVehicleSearch" />
    </view>
    <view class="popup-search-row">
      <t-search class="popup-search" placeholder="车架号、车型或客户手机号" value="{{vehicleSearchKeyword}}" bind:change="onVehicleSearchInput" bind:submit="onVehicleSearch" />
    </view>
    <scroll-view scroll-y class="search-result-list">
      <view class="result-section-title" wx:if="{{vehicleSearchState === 'recent'}}">最近车辆</view>
      <view class="search-result-item" wx:for="{{vehicleSearchResults}}" wx:key="id" bind:tap="selectVehicle" data-item="{{item}}">
        <view class="result-name">{{item.frameNo}}</view>
        <view class="result-desc">{{item.model || '-'}} | 车主: {{item.customerName}}</view>
      </view>
      <view class="empty-state" wx:if="{{vehicleSearchState === 'loading'}}">搜索中</view>
      <view class="empty-state" wx:if="{{vehicleSearchState === 'empty'}}">未找到车辆，可手动填写车辆信息</view>
      <view class="empty-state" wx:if="{{vehicleSearchState === 'error'}}">车辆搜索失败，请稍后重试</view>
      <view class="empty-state" wx:if="{{vehicleSearchState === 'idle'}}">输入车架号/车型/客户手机号搜索</view>
    </scroll-view>
  </t-popup>

  <t-toast id="t-toast" />
</view>
