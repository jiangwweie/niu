.container {
  padding-bottom: 40rpx;
}
.list {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.card-body {
  display: flex;
  flex-direction: column;
}
.info {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
