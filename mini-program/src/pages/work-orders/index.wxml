<view class="container">
  <!-- 顶部搜索 + 新建按钮 -->
  <view class="toolbar">
    <view class="search-wrap">
      <t-search
        value="{{keyword}}"
        placeholder="搜索工单号、客户名、手机号、车架号"
        bind:change="onSearch"
        bind:clear="onClear"
        bind:submit="onSubmitSearch"
        bind:action-click="onSubmitSearch"
      />
    </view>
    <t-button
      wx:if="{{hasCreateOrderPermission}}"
      theme="primary"
      size="small"
      icon="add"
      bind:tap="goToCreate"
      custom-style="flex-shrink:0;margin-left:12rpx;"
    >新建</t-button>
  </view>

  <!-- 状态筛选 tabs -->
  <scroll-view scroll-x class="status-tabs">
    <view
      wx:for="{{progressTabs}}"
      wx:key="value"
      class="tab-item {{activeStatus === item.value ? 'tab-active' : ''}}"
      bindtap="onTabChange"
      data-status="{{item.value}}"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 工单列表 -->
  <view class="list">
    <block wx:if="{{orders.length > 0}}">
      <view
        class="card"
        wx:for="{{orders}}"
        wx:key="id"
        bindtap="onTapDetail"
        data-id="{{item.id}}"
      >
        <view class="card-row card-row-top">
          <text class="order-no">{{item.workOrderNo}}</text>
          <view class="status-tag progress-{{item.progressKey}}">{{item.progressText}}</view>
        </view>
        <view class="card-row" wx:if="{{item.cashierText}}">
          <text class="info-label">收银</text>
          <view class="cashier-tag cashier-{{item.cashierStatus || 'UNKNOWN'}}">{{item.cashierText}}</view>
        </view>
        <view class="card-row">
          <text class="info-label">客户</text>
          <text class="info-val">{{item.customerNameSnapshot || '-'}}</text>
          <text class="info-label ml">车型</text>
          <text class="info-val">{{item.vehicleModelSnapshot || '-'}}</text>
        </view>
        <view class="card-row">
          <text class="info-label">应收</text>
          <text class="money">¥{{item.receivableAmount != null ? item.receivableAmount : '-'}}</text>
          <text class="info-label ml">净实收</text>
          <text class="money money-green">¥{{item.netReceived != null ? item.netReceived : item.receivedAmount != null ? item.receivedAmount : '-'}}</text>
          <text class="info-label ml" wx:if="{{item.outstandingAmount > 0}}">待收</text>
          <text class="money money-amber" wx:if="{{item.outstandingAmount > 0}}">¥{{item.outstandingDisplay}}</text>
        </view>
        <view class="card-time">{{item.createdAtText}}</view>
        <view class="card-actions" wx:if="{{hasUpdateOrderPermission && item.progressKey === 'DRAFT'}}">
          <t-button size="small" theme="primary" variant="outline" catchtap="onEditDraft" data-id="{{item.id}}">编辑草稿</t-button>
        </view>
      </view>
      <view wx:if="{{loadingMore}}" class="load-more-tip">加载中...</view>
      <view wx:elif="{{!hasMore && orders.length > 0}}" class="load-more-tip">没有更多工单了</view>
    </block>
    <view wx:elif="{{!loading}}" class="empty">
      <block wx:if="{{keyword}}">
        <view class="empty-icon">🔍</view>
        <text class="empty-text">没有找到相关工单，请更换关键词</text>
      </block>
      <block wx:elif="{{activeStatus}}">
        <view class="empty-icon">📋</view>
        <text class="empty-text">该状态暂无工单</text>
      </block>
      <block wx:else>
        <view class="empty-icon">📋</view>
        <text class="empty-text">暂无工单，可从工作台新建工单</text>
      </block>
    </view>
  </view>
</view>
