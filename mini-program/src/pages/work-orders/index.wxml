<view class="container">
  <!-- 顶部搜索 + 新建按钮 -->
  <view class="toolbar">
    <view class="search-wrap">
      <t-search value="{{keyword}}" placeholder="搜索工单号 / 客户姓名" bind:change="onSearch" bind:clear="onClear" />
    </view>
    <t-button
      wx:if="{{hasCreateOrderPermission}}"
      theme="primary"
      size="small"
      icon="add"
      bind:tap="goToCreate"
      custom-style="flex-shrink:0;margin-left:12rpx;"
    >新建</t-button>
  </view>

  <!-- 状态筛选 tabs -->
  <scroll-view scroll-x class="status-tabs">
    <view
      class="tab-item {{activeStatus === '' ? 'tab-active' : ''}}"
      bindtap="onTabChange"
      data-status=""
    >全部</view>
    <view
      class="tab-item {{activeStatus === 'PENDING_ACCEPT' ? 'tab-active' : ''}}"
      bindtap="onTabChange"
      data-status="PENDING_ACCEPT"
    >待接单</view>
    <view
      class="tab-item {{activeStatus === 'PART_ARRIVED' ? 'tab-active' : ''}}"
      bindtap="onTabChange"
      data-status="PART_ARRIVED"
    >已到件</view>
    <view
      class="tab-item {{activeStatus === 'SETTLED' ? 'tab-active' : ''}}"
      bindtap="onTabChange"
      data-status="SETTLED"
    >已结算</view>
    <view
      class="tab-item {{activeStatus === 'CANCELLED' ? 'tab-active' : ''}}"
      bindtap="onTabChange"
      data-status="CANCELLED"
    >已取消</view>
  </scroll-view>

  <!-- 工单列表 -->
  <view class="list">
    <block wx:if="{{filteredOrders.length > 0}}">
      <view
        class="card"
        wx:for="{{filteredOrders}}"
        wx:key="id"
        bindtap="onTapDetail"
        data-id="{{item.id}}"
      >
        <view class="card-row card-row-top">
          <text class="order-no">{{item.workOrderNo}}</text>
          <view class="status-tag status-{{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="card-row">
          <text class="info-label">客户</text>
          <text class="info-val">{{item.customerNameSnapshot || '-'}}</text>
          <text class="info-label ml">车型</text>
          <text class="info-val">{{item.vehicleModelSnapshot || '-'}}</text>
        </view>
        <view class="card-row">
          <text class="info-label">应收</text>
          <text class="money">¥{{item.receivableAmount != null ? item.receivableAmount : '-'}}</text>
          <text class="info-label ml">实收</text>
          <text class="money money-green">¥{{item.receivedAmount != null ? item.receivedAmount : '-'}}</text>
        </view>
        <view class="card-time">{{item.createdAtText}}</view>
      </view>
    </block>
    <view wx:else class="empty">
      <view class="empty-icon">📋</view>
      <text class="empty-text">暂无工单，可从快捷操作新建工单</text>
    </view>
  </view>
</view>
