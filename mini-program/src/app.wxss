page {
  background-color: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  color: #1f2933;
}

.niu-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f6f8;
}

.niu-section {
  margin-bottom: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.niu-section-header {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.niu-section-title {
  color: #1f2933;
  font-size: 30rpx;
  font-weight: 700;
}

.niu-helper {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
}

.niu-tip {
  margin: 0 32rpx 16rpx;
  padding: 18rpx 20rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.5;
  background: #f7f9fb;
  border-radius: 12rpx;
}

.niu-form-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f2f5;
  box-sizing: border-box;
}

.niu-form-label {
  width: 132rpx;
  flex-shrink: 0;
  color: #1f2933;
  font-size: 30rpx;
}

.niu-form-input {
  min-width: 0;
  flex: 1;
  height: 88rpx;
  color: #1f2933;
  font-size: 30rpx;
}

.niu-form-input::placeholder {
  color: #98a2b3;
}

.niu-form-action {
  min-width: 104rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  color: #0052d9;
  font-size: 28rpx;
  font-weight: 600;
}

.niu-form-action.muted {
  color: #98a2b3;
}

.niu-form-action:active {
  opacity: 0.72;
}

.niu-action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 32rpx;
}

.niu-action-tile {
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 600;
  background: #ffffff;
  border: 1rpx solid #e6e9ef;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.niu-action-tile.primary {
  color: #0052d9;
  background: #f2f6ff;
  border-color: #b8d3ff;
}

.niu-action-tile:active {
  background: #f7f9fb;
}

.niu-bottom-action {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e6e9ef;
}

.niu-empty {
  padding: 56rpx 32rpx;
  color: #667085;
  font-size: 28rpx;
  text-align: center;
}

.niu-status-text {
  font-size: 24rpx;
  font-weight: 600;
}

.niu-text-success {
  color: #2ba471;
}

.niu-text-warning {
  color: #ed7b2f;
}

.niu-text-danger {
  color: #d54941;
}
